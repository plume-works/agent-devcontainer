#!/usr/bin/env bash
# A stand-in gh for clones whose remote is a local bare repository: it knows no
# pull requests and logs every call beside itself.
set -euo pipefail

printf '%s\n' "$*" >>"$(dirname -- "${BASH_SOURCE[0]}")/gh-calls.log"
case "${1:-} ${2:-}" in
  "pr list" | "auth status") exit 0 ;;
  *)
    printf 'gh stub: unsupported command: %s\n' "$*" >&2
    exit 1
    ;;
esac
