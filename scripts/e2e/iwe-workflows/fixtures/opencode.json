{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@CATALOG@/.opencode-plugin"],
  "small_model": "openai/gpt-6-luna",
  "command": {
    "e2e-prompt": {
      "description": "Run the arguments as a plain prompt.",
      "template": "$ARGUMENTS"
    }
  },
  "permission": {
    "external_directory": {
      "@WORK@/*": "allow",
      "@CATALOG@/agents/*": "allow"
    }
  }
}
