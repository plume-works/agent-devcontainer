# Settings for compose.opencode.yml. Copy to a private file outside the repository and
# pass it with `docker compose --env-file <file> ...`. Never commit real values.

# Required. OpenCode's server password; the proxy forwards to port 4096 with it.
OPENCODE_SERVER_PASSWORD=
# Required unless AGENTDEV_SKIP_XPRA is set. Xpra's session password, separate from
# OpenCode's; the HTML5 client asks for it when connecting.
XPRA_PASSWORD=
# Required. Name of the existing Docker network the reverse proxy is attached to.
AGENTDEV_PROXY_NETWORK=

# Runtime identity. Every container sharing one AGENTDEV_AUTH_VOLUME must use the same
# numeric IDs; the bind override also needs the checkout writable by them.
AGENTDEV_UID=1000
AGENTDEV_GID=1000
AGENTDEV_AUTH_VOLUME=agentdev-opencode-auth

# Workspace. Without the bind override, an empty workspace volume is cloned once from
# AGENTDEV_REPOSITORY_URL (optionally at AGENTDEV_REPOSITORY_REF) and reused afterwards.
AGENTDEV_REPOSITORY_URL=
AGENTDEV_REPOSITORY_REF=
# With compose.opencode.bind.yml: the host checkout mounted at /workspaces/project.
AGENTDEV_CHECKOUT=

# GitHub HTTPS access for clone and later Git operations. Not stored in the container.
GH_TOKEN=

# Optional services and limits. Booleans take 1, true, yes, or on, and 0, false, no,
# off, or empty, in any case; counts and deadlines must be positive. Any other value
# latches the runtime failed before startup, naming the variable.
AGENTDEV_SKIP_XPRA=
# Seconds for the root bootstrap (account and volume checks, firewall).
AGENTDEV_BOOTSTRAP_TIMEOUT=1800
# Seconds for each preparation step, such as the first clone or uv sync.
AGENTDEV_PREPARE_TIMEOUT=1800
# Seconds for a service to pass its first readiness probe.
AGENTDEV_SERVICE_START_TIMEOUT=60
# Recovery attempts per service (a positive integer), and the first backoff in
# seconds, doubled on each attempt.
AGENTDEV_RECOVERY_ATTEMPTS=3
AGENTDEV_RECOVERY_BACKOFF=1
# Seconds a service must stay healthy before its recovery budget resets.
AGENTDEV_HEALTHY_RESET=60
# Seconds between controller checks; health treats three missed ones as a dead controller.
AGENTDEV_HEALTH_INTERVAL=2
# Consecutive failed probes (a positive integer) that count as a failure.
AGENTDEV_PROBE_FAILURES=2
# Seconds each service gets to stop before it is killed (a positive integer).
AGENTDEV_STOP_TIMEOUT=30
# true: any optional failure (nested Docker, CBM, catalog, uv sync, pre-commit hooks,
# indexing, Xpra) latches the runtime failed and stops OpenCode, instead of leaving
# OpenCode serving with the runtime degraded.
AGENTDEV_STRICT_STARTUP=false

# Opt-in egress firewall, a boolean like those above. When enabled, list the proxy's
# source addresses.
ENABLE_FIREWALL=false
AGENTDEV_TRUSTED_PROXY_CIDRS=
