# Settings for compose.opencode.yml. Copy to a private file outside the repository and
# pass it with `docker compose --env-file <file> ...`. Never commit real values.

# Required. OpenCode's server password; the proxy forwards to port 4096 with it.
OPENCODE_SERVER_PASSWORD=
# Required. Name of the existing Docker network the reverse proxy is attached to.
AGENTDEV_PROXY_NETWORK=

# Runtime identity. Every container sharing one AGENTDEV_AUTH_VOLUME must use the same
# numeric IDs; the bind override also needs the checkout writable by them.
AGENTDEV_UID=1000
AGENTDEV_GID=1000
AGENTDEV_AUTH_VOLUME=agentdev-opencode-auth

# Workspace. Without the bind override, an empty workspace volume is cloned once from
# AGENTDEV_REPOSITORY_URL (optionally at AGENTDEV_REPOSITORY_REF) and reused afterwards.
AGENTDEV_REPOSITORY_URL=
AGENTDEV_REPOSITORY_REF=
# With compose.opencode.bind.yml: the host checkout mounted at /workspaces/project.
AGENTDEV_CHECKOUT=

# GitHub HTTPS access for clone and later Git operations. Not stored in the container.
GH_TOKEN=

# Optional services and limits.
AGENTDEV_SKIP_XPRA=
AGENTDEV_PREPARE_TIMEOUT=1800

# Opt-in egress firewall. When enabled, list the proxy's source addresses.
ENABLE_FIREWALL=false
AGENTDEV_TRUSTED_PROXY_CIDRS=
