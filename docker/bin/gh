#!/usr/bin/env bash
# Transparent gh wrapper: injects GH_TOKEN from the host's git credential helper,
# then delegates to the real gh. Silent by default; set VERBOSE_GH=1 to see what it did.
set -euo pipefail

# Marker used to recognise copies of this wrapper on PATH (see discovery below).
# Kept as the bare string "gh-wrapper" so that older, pre-marker copies of this
# script — which still say "gh-wrapper:" in their log output — are detected too.
# gh-wrapper-marker: transparent-auth-shim

# Discover the real gh by walking PATH and skipping every copy of this wrapper
# (a live workspace copy and the image-baked /usr/local/bin/gh both shadow the
# real binary). Hard-coding /usr/bin/gh breaks whenever gh lives elsewhere, so
# that path is only the last-resort fallback.
self_path=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
real_gh=""
while IFS= read -r candidate; do
  [[ -x "$candidate" ]] || continue
  resolved=$(readlink -f -- "$candidate" 2>/dev/null || echo "$candidate")
  [[ "$resolved" == "$self_path" ]] && continue
  # Only script candidates can be a copy of this wrapper; skip the grep for the
  # real (multi-megabyte) gh binary.
  IFS= read -r first_line < "$resolved" 2>/dev/null || first_line=""
  if [[ "$first_line" == '#!'* ]] && grep -qsF -m1 -- 'gh-wrapper' "$resolved"; then
    continue
  fi
  real_gh="$resolved"
  break
done < <(type -aPf gh 2>/dev/null || true)

if [[ -z "$real_gh" && -x /usr/bin/gh ]]; then
  real_gh=/usr/bin/gh
fi

if [[ -z "$real_gh" ]]; then
  echo "gh-wrapper: real gh not found on PATH" >&2
  exit 127
fi

log() {
  if [[ -n "${VERBOSE_GH:-}" ]]; then
    echo "gh-wrapper: $*" >&2
  fi
}

# Re-entrancy guard: the wrapper can legitimately be on PATH twice (a live
# workspace copy ahead of the image-baked default at /usr/local/bin/gh). Only
# the first invocation in a process tree should do any work.
if [[ -n "${GH_WRAPPER_ACTIVE:-}" ]]; then
  log "already active in this process tree, delegating immediately"
  exec "$real_gh" "$@"
fi
export GH_WRAPPER_ACTIVE=1

if [[ -n "${GH_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]]; then
  log "GH_TOKEN/GITHUB_TOKEN already set, leaving as-is"
elif helper=$(git config --get credential.helper 2>/dev/null) && [[ -n "$helper" ]]; then
  log "credential.helper configured, attempting git credential fill"
  token=$(printf 'protocol=https\nhost=github.com\n\n' | timeout 2 git credential fill 2>/dev/null | grep '^password=' | cut -d= -f2- || true)
  if [[ -n "$token" ]]; then
    log "derived GH_TOKEN from host credential helper"
    export GH_TOKEN="$token"
  else
    log "credential fill returned nothing usable"
  fi
else
  log "no credential.helper configured, skipping extraction"
fi

exec "$real_gh" "$@"
