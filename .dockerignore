# The image build context is the repository root; keep it small. The build consumes only
# ansible/, docker/, the seeded catalog (.claude-plugin/ and its .agents/ plugin tree),
# py_packages/validate_agent_files/, and py_packages/agentdev_runtime/.
.git
.github
.claude
.devcontainer
# The runtime images bake only the firewall allowlist from .devcontainer.
!.devcontainer/firewall-allowlist.txt
.tmp
.venv
node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.tmp
# Editable-install metadata: stale by definition and confuses the wheel build.
**/*.egg-info
