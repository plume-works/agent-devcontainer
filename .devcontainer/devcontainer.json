{
  "name": "Agent Devcontainer",
  "initializeCommand": ".devcontainer/devcontainer-init.sh",
  // devcontainer-compose-pins.yml overrides the devcontainer service image with the digest pin
  // Renovate manages; see the comment at the top of that file for why it lives at the
  // repository root instead of here.
  "dockerComposeFile": [
    "docker-compose.yml",
    "../devcontainer-compose-pins.yml"
  ],
  "service": "devcontainer",
  // agentdev-devcontainer supplies the lifecycle commands, waitFor, and the supervised
  // services, nested Docker included, through its image metadata; see
  // spec/agentdev-runtime-images. Declaring them here too would run each twice.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    // The firewall is installed in the image but inert until this is "true".
    // See .devcontainer/firewall-allowlist.txt for the allowed destinations.
    "ENABLE_FIREWALL": "false",

    "DEVCONTAINER_ID": "${devcontainerId}",
    "DEV_WORKSPACE_FOLDER": "/workspaces/${localWorkspaceFolderBasename}",
    // From the host environment or the hosting platform's secret store; empty when unset.
    "EXPO_TOKEN": "${localEnv:EXPO_TOKEN}",

    // uv's cache, interpreters, and pre-commit's cache take their defaults on the home volume,
    // never on a volume inside the checkout.
    // Each checkout's .venv links to its own environment here: see spec/agentdev-runtime-images.
    "AGENTDEV_VENV_ROOT": "/home/agent/.local/share/uv/venvs"
  },

  "forwardPorts": [14500],
  "portsAttributes": {
    // No requireLocalPort: the Ports panel can map Xpra to a different local port.
    "14500": {
      "label": "Xpra HTML5",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    {
      // Sibling checkout opened as ../project by agent-devcontainer-and-project.code-workspace;
      // per instance so its uncommitted work survives a rebuild without worktrees sharing it.
      "source": "agentdev-project",
      "target": "/workspaces/project",
      "type": "volume"
    }
    // The image mounts the per-instance home volume; docker-compose.yml mounts the auth
    // volume shared by every container of the host user's UID and GID.
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "redhat.ansible",
        "ipierre1.ansible-vault-vscode",
        "samuelcolvin.jinjahtml",
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "executablebookproject.myst-highlight",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.cmake-tools",
        "mads-hartmann.bash-ide-vscode",
        "rogalmic.bash-debug",
        "rpinski.shebang-snippets",
        "streetsidesoftware.code-spell-checker",
        "ryanluker.vscode-coverage-gutters",
        "elagil.pre-commit-helper",
        "iliazeus.vscode-ansi",
        "dlech.chmod",
        "yy0931.save-as-root",
        "anjali.clipboard-history",
        "chrisdias.vscode-opennewinstance",
        "davidkol.fastcompare",
        "batyan-soft.fast-tasks",
        "1password.op-vscode",
        "IWE.iwe"
      ],
      "settings": {
        // Python: uv owns the virtualenv, so never let VS Code auto-activate it.
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
        "python.terminal.activateEnvironment": false,
        "python.terminal.activateEnvInCurrentTerminal": false,
        "python.analysis.typeCheckingMode": "standard",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["py_packages"],
        "[python]": {
          "editor.formatOnSave": false,
          "editor.defaultFormatter": "charliermarsh.ruff" // cSpell:disable-line
        },
        "ruff.organizeImports": true,
        "ruff.fixAll": true,
        "ruff.lint.enable": true,

        "ansible.ansible.path": "${workspaceFolder}/.venv/bin/ansible",
        "ansible.python.interpreterPath": "${workspaceFolder}/.venv/bin/python3",
        "ansible.validation.lint.path": "${workspaceFolder}/.venv/bin/ansible-lint",
        "ansible.mcpServer.enabled": true,
        "files.associations": {
          "**/ansible/**/*.yml": "ansible",
          "**/ansible/**/*.yaml": "ansible"
        },

        "cmake.configureOnEdit": false,
        "cmake.configureOnOpen": false,
        "cmake.cmakePath": "cmake",
        "cmake.generator": "Ninja",
        "cmake.exportCompileCommandsFile": true,

        "coverage-gutters.coverageFileNames": [
          "*.info",
          "coverage.xml",
          "lcov.info"
        ],
        "coverage-gutters.showLineCoverage": true,
        "coverage-gutters.highlightdark": "rgba(0, 122, 30, 0.1)",
        "coverage-gutters.partialHighlightDark": "rgba(163, 149, 0, 0.1)",
        "coverage-gutters.noHighlightDark": "rgba(163, 0, 0, 0.1)",

        "search.exclude": {
          "**/node_modules": true,
          "**/.venv": true,
          "**/.tmp": true,
          "**/*.code-search": true
        },

        "cSpell.words": [
          "agentdev",
          "devcontainer",
          "dotfiles",
          "fisher",
          "hadolint",
          "iwes",
          "noqa",
          "pytest",
          "rgba",
          "shellcheck",
          "venv",
          "virtualenv",
          "xpra",
          "zizmor"
        ],

        // Copilot / VS Code chat agent behaviour
        "github.copilot.chat.codeGeneration.useInstructionFiles": true,
        "github.copilot.chat.notebook.alternativeFormat": "markdown",
        "github.copilot.nextEditSuggestions.enabled": true,
        "github.copilot.enable": {
          "*": true
        },
        "chat.agent.enabled": true,
        "chat.agent.maxRequests": 250,
        "chat.useAgentSkills": true,
        "chat.useAgentsMdFile": true,
        "chat.mcp.gallery.enabled": true,
        "chat.mcp.autostart": "newAndOutdated",
        "chat.tools.terminal.autoApprove": {
          "/.*/": true, // Allow all commands, denied commands will still need approval.
          "gh": true,
          "rm": false
        },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
        "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",
        "chat.tools.terminal.autoReplyToPrompts": true,
        "chat.tools.urls.autoApprove": {
          "https://code.visualstudio.com": true,
          "https://code.visualstudio.com/docs": true,
          "https://github.com": true,
          "https://docs.github.com": true,
          "https://*.github.com": {
            "approveRequest": true
          },
          "https://raw.githubusercontent.com/github/github-mcp-server/": true,
          "https://www.google.com/search": true,
          "https://docs.docker.com": true,
          "https://code.claude.com/docs/en/": true
        }
      }
    }
  }
}
