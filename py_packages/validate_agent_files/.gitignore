# This package is released on its own, so the ignore rules of the repository
# that develops it do not follow it. Everything its own tooling generates has to
# be ignored from here.
.tmp/
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/

# A library resolves against its consumer's constraints, so the lock a bare
# `uv run` writes here is scratch, not a pin.
uv.lock
