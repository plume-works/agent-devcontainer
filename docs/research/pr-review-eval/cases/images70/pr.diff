--- /dev/null
+++ b/docs/adr/0020-pull-requests-from-collaborators-only.md
@@ -0,0 +1,10 @@
+# Pull requests from collaborators only
+
+This repository takes no outside contributions. Pull requests come from collaborators' branches of this
+repository, and from Renovate. Forks are out of scope for every feature: nothing is designed or kept working for
+them, and a pull request from a fork fails its checks.
+
+## Considered Options
+
+- Forks build and test without publishing (the previous behaviour, never recorded as an ADR).
+- A separate, reduced path for forks in each feature.
diff --git a/docs/adr/0021-build-cache-in-the-registry.md b/docs/adr/0021-build-cache-in-the-registry.md
new file mode 100644
index 0000000..9f9462e
--- /dev/null
+++ b/docs/adr/0021-build-cache-in-the-registry.md
@@ -0,0 +1,16 @@
+# Build cache in the registry
+
+CI caches every build step of each image, separately for each architecture, in the image's own GHCR package
+beside its tags. Every CI run reads and writes it, pull requests and `main` alike. Local builds do not use it.
+
+## Considered Options
+
+- No cache: every run rebuilds every image from scratch.
+- The GitHub Actions cache: capped in size, evicts, and is scoped per branch.
+- A separate cache package per image: more packages to manage, for no gain.
+
+## Consequences
+
+- The cache tags are visible in each image's package.
+- A superseded cache stays as an untagged version, like the other untagged images the cleanup keeps.
+- Pull requests and `main` share one cache per image and architecture, so each overwrites the other's.
diff --git a/images/docker-bake.hcl b/images/docker-bake.hcl
index 96d64c6..40b4b59 100644
--- a/images/docker-bake.hcl
+++ b/images/docker-bake.hcl
@@ -14,6 +14,8 @@ variable "REGISTRY" { default = "ghcr.io/plume-works" }
 variable "PUSH" { default = false }
 # CI sets linux/amd64 or linux/arm64.
 variable "PLATFORM" { default = "" }
+# CI sets CACHE=true; needs PLATFORM, since each architecture has its own cache.
+variable "CACHE" { default = false }
 
 # The local :ci tag the smoke scripts use. Set as the docker output's name, not as `tags`: bake would add `tags`
 # to the push output too, and a tagged name cannot be pushed by digest.
@@ -30,6 +32,22 @@ function "out" {
   )
 }
 
+function "cache_ref" {
+  params = [name]
+  result = "${REGISTRY}/${name}:cache-${replace(PLATFORM, "linux/", "")}"
+}
+
+function "cache_from" {
+  params = [name]
+  result = CACHE ? ["type=registry,ref=${cache_ref(name)}"] : []
+}
+
+# mode=max: also cache the layers of intermediate stages. image-manifest=true: GHCR rejects the default cache index.
+function "cache_to" {
+  params = [name]
+  result = CACHE ? ["type=registry,ref=${cache_ref(name)},mode=max,image-manifest=true,oci-mediatypes=true"] : []
+}
+
 group "default" {
   targets = ["core", "core-systemd", "coder-template", "devcontainer-base"]
 }
