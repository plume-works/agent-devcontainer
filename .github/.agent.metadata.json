{
  "iwe-map": {
    "digest_ignore": {
      "**/*.yml": [
        {
          "pattern": "(uses: [^@\\s]+)@v[0-9]+(\\.[0-9]+)*",
          "replace": "\\1@v<PIN>",
          "reason": "Renovate automerges github-actions version bumps (.github/renovate.json)."
        },
        {
          "pattern": "version: '[0-9]+\\.[0-9]+\\.[0-9]+'",
          "replace": "version: '<PIN>'",
          "reason": "Tool versions pinned to actions, bumped by the same automerge."
        }
      ]
    }
  }
}
