#!/usr/bin/env bash
set -euo pipefail

# Prefer versioned and system interpreters over environment shims.
# Hooks fail open when no supported Python interpreter is available.

here=$(dirname "$0")
entry="$here/si.py"

min_check='import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'

for candidate in \
    python3.14 python3.13 python3.12 \
    /usr/bin/python3 python3 python
do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c "$min_check" >/dev/null 2>&1
    then
        exec "$candidate" "$entry" "$@"
    fi
done

exit 0
