#!/bin/sh
# Single entry point for every hook and skill invocation.
#
# Hooks inherit the user's shell environment, where `python3` is frequently a
# stale virtualenv: on the development machine for this plugin it resolves to a
# 2019 environment running 3.6.5. Versioned interpreter names are checked first
# for that reason, matching how the official security-guidance plugin resolves
# its own interpreter. /usr/bin/python3 is checked before bare python3 because
# on macOS it is always a real system interpreter, never a shim.
#
# Failing to find an interpreter exits 0. Capture hooks must fail open, and a
# machine without a usable python3 is not a reason to disturb a completed task.

set -u

here=$(dirname "$0")
entry="$here/si.py"

min_check='import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)'

for candidate in \
    python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 \
    /usr/bin/python3 python3 python
do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c "$min_check" >/dev/null 2>&1
    then
        exec "$candidate" "$entry" "$@"
    fi
done

exit 0
