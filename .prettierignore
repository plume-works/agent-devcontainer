ansible/**/*.yml
ansible/**/*.yaml

# docs/knowledge is normalized by `iwe normalize` (enforced in
# validate-knowledge-base.yml), which disagrees with prettier on markdown
# emphasis style; letting both fight over the same files makes every commit
# re-flip the formatting.
docs/knowledge/**

# The iwe-bootstrap scaffold is the workspace a consumer receives; `iwe normalize`
# owns its markdown formatting, the same way it owns docs/knowledge above.
.agents/plugins/agentdev/skills/iwe-bootstrap/assets/**

# The devcontainer CLI owns this file and rewrites it, without a final newline, on
# every `devcontainer up`.
.devcontainer/devcontainer-lock.json

# `openspec init` and `openspec update` own the skills they install and rewrite them
# on every run.
.claude/skills/openspec-*/**
.opencode/skills/openspec-*/**
