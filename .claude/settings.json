{
  "model": "opus",
  "cleanupPeriodDays": 14,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Agent",
      "ToolSearch",
      "Skill",
      "WebSearch",
      "Read(//workspaces/**)",
      "Read(//root/**)",
      "Edit(//workspaces/**)",
      "Edit(//tmp/**)",
      "Edit(**/.tmp)",
      "Edit(**/.tmp/**)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git)",
      "Bash(git *)",
      "Bash(.agents/plugins/agentdev/skills/*/agent-code/*)",
      "Bash(/root/.claude/plugins/cache/agent-devcontainer/agentdev/*)",
      "Bash(/home/agent/.claude/plugins/cache/agent-devcontainer/agentdev/*)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(mkdir *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv pip *)",
      "Bash(bun run *)",
      "Bash(bun test*)",
      "Bash(bun install*)",
      "Bash(bunx *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -c *)",
      "Bash(python3 -m pytest *)",
      "Bash(python_lint_check.py *)",
      "Bash(pre-commit run *)",
      "mcp__github__*"
    ],
    "additionalDirectories": [
      "/tmp",
      "/workspaces",
      "/__w"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/startup.py resume",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  }
}
