{
  "model": "opus",
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
  },
  "attribution": {
    "commit": "- agent commit -",
    "pr": "",
    "sessionUrl": false
  },
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "ReportFindings",
      "AskUserQuestion",

      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "allow": [
      "Agent",
      "ToolSearch",
      "Skill",
      "WebSearch",
      "Read(//workspaces/**)",
      "Read(//root/**)",
      "Edit(//workspaces/**)",
      "Edit(//tmp/**)",
      "Edit(**/.tmp)",
      "Edit(**/.tmp/**)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git)",
      "Bash(git *)",
      "Bash(.agents/plugins/agentdev/skills/*/agent-code/*)",
      "Bash(/root/.claude/plugins/cache/agent-devcontainer/agentdev/*)",
      "Bash(/home/agent/.claude/plugins/cache/agent-devcontainer/agentdev/*)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(mkdir *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv pip *)",
      "Bash(bun run *)",
      "Bash(bun test*)",
      "Bash(bun install*)",
      "Bash(bunx *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -c *)",
      "Bash(python3 -m pytest *)",
      "Bash(python_lint_check.py *)",
      "Bash(pre-commit run *)",
      "mcp__github__*"
    ],
    "additionalDirectories": [
      "/tmp",
      "/workspaces",
      "/__w"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/startup.py resume",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
